# لە my.telegram.org وەریگرە (App -> API development tools)
API_ID=123456
API_HASH=your_api_hash_here

# لە @BotFather وەریگرە
BOT_TOKEN=123456:ABC-your-bot-token

# کلیلی AI (بۆ وەڵامدانەوەی زیرەکانە). ئەگەر Anthropic بەکاردەهێنیت ئەمە پڕبکەرەوە
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
# یان ئەگەر OpenAI بەکاردەهێنیت
OPENAI_API_KEY=

# چەند خولەک/پەیام دوای چوونەژوورەوە، بەکارهێنەر وەک "نوێ" دادەنرێت (بۆ سڕینەوەی لینک)
NEW_MEMBER_WINDOW_SECONDS=600
